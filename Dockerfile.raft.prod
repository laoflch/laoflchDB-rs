# laoflchDB Raft 分布式 KV 存储节点镜像
# 构建命令示例：
#   docker build -t laoflchdb-raft:$(grep '^version = ' Cargo.toml | sed 's/version = "\([^+"]*\).*/\1/') -f Dockerfile_raft.prod .
#
# 单节点启动示例：
#   docker run -d --name raft-node-1 -p 29999:29999 \
#     -v raft_data_1:/app/laoflch_raft_data \
#     laoflchdb-raft:0.1.13
#
# 多节点启动示例（同一 Docker 网络 raft-net）：
#   docker network create raft-net
#   docker run -d --network raft-net --name raft-node-1 -v raft_data_1:/app/laoflch_raft_data laoflchdb-raft:0.1.13
#   docker run -d --network raft-net --name raft-node-2 \
#     -v /path/to/node2_raft.yaml:/app/config/prod_raft.yaml \
#     -v raft_data_2:/app/laoflch_raft_data laoflchdb-raft:0.1.13

FROM ubuntu:24.04

# 版本号参数（从 Cargo.toml 获取前半段，如 0.1.13+xxx 取 0.1.13）
ARG VERSION=0.1.13
LABEL version="${VERSION}"

# Create app directories（Raft 数据目录建议用卷挂载持久化）
RUN mkdir -p /app/config && \
    mkdir -p /app/data && \
    mkdir -p /app/laoflch_raft_data

# Set working directory
WORKDIR /app

# Copy binary
COPY target/release/laoflchdb /app/laoflchdb

# Copy RocksDB ldb 工具（供数据落盘一致性校验等运维操作使用）
COPY target/release/ldb /usr/local/bin/ldb

# Copy raft-only production configuration
COPY config/prod_raft.yaml /app/config/prod_raft.yaml

# Copy RocksDB 运行时动态库（ldb 工具链接宿主机的 libsnappy/libgflags/libbz2/liblz4/libzstd/libjemalloc/libz，
# 由 deploy_raft_cluster.sh 在构建前准备到 deploy_raft/.runtime_libs）
COPY deploy_raft/.runtime_libs/ /usr/lib/x86_64-linux-gnu/

# libcuda.so.1 驱动库（28MB，与主镜像 laoflchdb 一致 COPY 进镜像）；
# 其余 CUDA 运行库（libcublas/libcublasLt/libcurand/libcudart ~681MB）不拷贝，
# 容器启动时通过 bind mount 映射宿主 /usr/local/cuda，见 deploy_raft_cluster.sh
COPY deploy_raft/.libcuda_libs/libcuda.so.1 /usr/lib/x86_64-linux-gnu/libcuda.so.1

# Expose raft gRPC port
EXPOSE 29999

# Environment variables
ENV RUST_LOG=info
ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64

# Start command with raft-only config
CMD ["/app/laoflchdb", "-c", "/app/config/prod_raft.yaml", "start"]
